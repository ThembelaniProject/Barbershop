# Local development environment
# Copy this file to .env and set your real values.
# NEVER commit the real .env file.

DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app

# Neon PostgreSQL
# Use the connection string from your Neon project.
DATABASE_URL=postgresql://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require&channel_binding=require

# Production / custom domain
# Vercel automatically provides VERCEL_URL.
# For a custom domain, add it to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS
# in the Vercel project Environment Variables.
# Example:
# ALLOWED_HOSTS=your-domain.com,.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
